<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <p class="footer-course">{{course.title}}</p>
      <p class="footer-meta">{{course.code}} · {{course.credits}} credits · {{course.program}}</p>
    </div>
    <div>
      <p class="footer-meta">Faculty of Data Science and Artificial Intelligence</p>
      <p class="footer-meta">National Economics University</p>
      {{#if course.links.github}}
      <p class="footer-meta"><a href="{{course.links.github}}">Course book on GitHub</a></p>
      {{/if}}
    </div>
  </div>
</footer>
