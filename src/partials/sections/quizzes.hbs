<section id="quizzes" class="section section-alt">
  <div class="wrap">
    <h2 class="section-title">Quizzes</h2>
    <p class="section-note">
      Self-marking multiple-choice quizzes. They run entirely in your browser and
      are not graded — use them to check your understanding after each lecture.
    </p>

    <div class="quiz-grid">
      {{#each quizzes.quizzes}}
      <article class="quiz-card">
        <p class="quiz-week">Week {{this.week}}</p>
        <h3 class="quiz-title"><a href="{{url this.link}}">{{this.title}}</a></h3>
        <p class="quiz-desc">{{this.description}}</p>
        {{#if this.topics}}
        <ul class="quiz-topics">
          {{#each this.topics}}<li>{{this}}</li>{{/each}}
        </ul>
        {{/if}}
        <p class="cta-row"><a class="btn btn-quiet" href="{{url this.link}}">Start quiz</a></p>
      </article>
      {{/each}}
    </div>
  </div>
</section>
