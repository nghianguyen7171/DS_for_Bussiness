<section id="overview" class="section">
  <div class="wrap">
    <h2 class="section-title">Course overview</h2>
    <div class="prose prose-narrow">
      {{{md course.description}}}
    </div>

    {{#if course.prerequisites}}
    <div class="subsection">
      <h3>Prerequisites</h3>
      <div class="prose prose-narrow">
        <ul>{{#each course.prerequisites}}<li>{{this}}</li>{{/each}}</ul>
      </div>
    </div>
    {{/if}}

    {{#if course.software}}
    <div class="subsection">
      <h3>Software</h3>
      <div class="prose prose-narrow">
        <ul>{{#each course.software}}<li>{{this}}</li>{{/each}}</ul>
      </div>
    </div>
    {{/if}}
  </div>
</section>
