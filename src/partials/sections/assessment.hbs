<section id="assessment" class="section section-alt">
  <div class="wrap">
    <h2 class="section-title">Assessment</h2>
    <div class="table-scroll">
      <table class="schedule">
        <thead>
          <tr>
            <th scope="col">Component</th>
            <th scope="col" class="col-date">Week</th>
            <th scope="col" class="col-week">Weight</th>
            <th scope="col">Criteria</th>
          </tr>
        </thead>
        <tbody>
          {{#each course.assessment.items}}
          <tr>
            <td><span class="lec-title">{{this.name}}</span>
              {{#if this.description}}<p class="lec-sub">{{this.description}}</p>{{/if}}
            </td>
            <td class="col-date">{{this.week}}</td>
            <td class="col-week"><strong>{{this.weight}}</strong></td>
            <td>{{this.criteria}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    <p class="section-note">
      Full details on <a href="{{url 'grading.html'}}">Grading</a> and
      <a href="{{url 'policies.html'}}">Policies</a>.
    </p>
  </div>
</section>
