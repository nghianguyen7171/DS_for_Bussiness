<section id="resources" class="section">
  <div class="wrap">
    <h2 class="section-title">Resources</h2>

    <div class="subsection">
      <h3>Course links</h3>
      <dl class="ref-list">
        {{#if course.links.book}}
        <dt><a href="{{course.links.book}}"><cite>Khoa học dữ liệu với Python</cite></a></dt>
        <dd>The course book, read online.</dd>
        {{/if}}
        {{#if course.links.github}}
        <dt><a href="{{course.links.github}}"><cite>Course book source on GitHub</cite></a></dt>
        <dd>Notebooks and text for the course book.</dd>
        {{/if}}
        {{#if course.links.slides}}
        <dt><a href="{{course.links.slides}}"><cite>Lecture slides (FIT room)</cite></a></dt>
        <dd>Slide decks hosted on the faculty platform.</dd>
        {{/if}}
      </dl>
    </div>

    <div class="subsection">
      <h3>Course pages</h3>
      <div class="prose prose-narrow">
        <ul>
          <li><a href="{{url 'syllabus.html'}}">Syllabus</a> — objectives, outcomes, weekly plan</li>
          <li><a href="{{url 'grading.html'}}">Grading</a> — how each component is marked</li>
          <li><a href="{{url 'policies.html'}}">Policies</a> — attendance, submission, conduct</li>
          <li><a href="{{url 'resources.html'}}">Reading and tools</a> — full resource list</li>
          <li><a href="{{url 'tur7-visualization.html'}}">Tutorial 7: Visualization</a> — worked walkthrough</li>
        </ul>
      </div>
    </div>

    {{#if answerKeys}}
    <div class="subsection">
      <h3 id="answer-keys">{{answerKeys.title}}</h3>
      <div class="prose prose-narrow">
        <p>{{answerKeys.description}}</p>
        {{#if answerKeys.stats}}
        <ul>
          <li>{{answerKeys.stats.total_exams}} exams, {{answerKeys.stats.total_questions}} questions</li>
          <li>{{answerKeys.stats.unique_questions}} unique questions ({{answerKeys.stats.match_rate}} match rate)</li>
        </ul>
        {{/if}}
        <p><a class="btn btn-quiet" href="{{url answerKeys.link}}">Open the answer keys</a></p>
      </div>
    </div>
    {{/if}}
  </div>
</section>
