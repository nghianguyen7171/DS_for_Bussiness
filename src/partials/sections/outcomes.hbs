<section id="outcomes" class="section">
  <div class="wrap">
    <h2 class="section-title">Objectives and learning outcomes</h2>

    <div class="subsection">
      <h3>Course objectives</h3>
      <div class="prose prose-narrow">
        <ul>
          {{#each course.objectives}}<li><strong>{{this.id}}.</strong> {{this.description}}</li>{{/each}}
        </ul>
      </div>
    </div>

    <div class="subsection">
      <h3>Course learning outcomes</h3>
      <div class="table-scroll">
        <table class="schedule">
          <thead>
            <tr>
              <th scope="col" class="col-clo">CLO</th>
              <th scope="col" class="col-week">Obj.</th>
              <th scope="col">Outcome</th>
              <th scope="col" class="col-week">Level</th>
            </tr>
          </thead>
          <tbody>
            {{#each course.learning_outcomes}}
            <tr>
              <td class="col-clo"><span class="lec-title">{{this.id}}</span></td>
              <td class="col-week">{{this.objective}}</td>
              <td>{{this.description}}</td>
              <td class="col-week">{{this.level}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
