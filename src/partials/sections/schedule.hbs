<section id="schedule" class="section">
  <div class="wrap">
    <h2 class="section-title">Schedule</h2>
    <p class="section-note">
      Fifteen weeks, alternating lecture and practice. Notebooks open in Jupyter
      or Google Colab. Weeks marked <span class="pill pill-tbd">TBD</span> are not
      yet finalized and publish no materials.
    </p>

    <div class="table-scroll">
      <table class="schedule">
        <thead>
          <tr>
            <th scope="col" class="col-week">Week</th>
            <th scope="col" class="col-type">Type</th>
            <th scope="col">Topic</th>
            <th scope="col" class="col-materials">Materials</th>
            <th scope="col" class="col-due">Assessment</th>
          </tr>
        </thead>
        <tbody>
          {{#each lectures.lectures}}
          <tr class="{{#unless (isReleased this.status)}}row-unreleased{{/unless}}">
            <td class="col-week">{{this.week}}</td>
            <td class="col-type"><span class="pill pill-{{this.type}}">{{this.type}}</span></td>
            <td>
              <span class="lec-title">{{this.title}}</span>
              {{#unless (isReleased this.status)}}
                <span class="pill pill-{{this.status}}">{{statusLabel this.status}}</span>
              {{/unless}}
              {{#if this.topics}}
              <ul class="lec-topics">
                {{#each this.topics}}<li>{{this}}</li>{{/each}}
              </ul>
              {{/if}}
              {{#if this.activities}}
              <details class="lec-activities">
                <summary>Class activities</summary>
                <ul>{{#each this.activities}}<li>{{this}}</li>{{/each}}</ul>
              </details>
              {{/if}}
            </td>
            <td class="col-materials">
              {{#if (isReleased this.status)}}
                {{#if this.materials}}<p class="mat-text">{{this.materials}}</p>{{/if}}
                {{#if this.notebook}}<a class="mat mat-slide" href="{{url this.notebook}}">Notebook</a>{{/if}}
                {{#if this.answer_key}}<a class="mat" href="{{url this.answer_key}}">Answer key</a>{{/if}}
                {{#if this.supply_pdf}}<a class="mat" href="{{url this.supply_pdf}}">Supplement (PDF)</a>{{/if}}
                {{#if this.slides}}<a class="mat" href="{{this.slides}}">Slides</a>{{/if}}
                {{#if this.dataset_link}}<a class="mat" href="{{this.dataset_link}}">Dataset</a>{{/if}}
                {{#if this.submission_link}}<a class="mat" href="{{this.submission_link}}">Submit</a>{{/if}}
                {{#if this.answer_keys_link}}<a class="mat" href="{{url this.answer_keys_link}}">Answer keys</a>{{/if}}
                {{#if this.extra}}
                  {{#each this.extra}}<a class="mat" href="{{url this.href}}">{{this.label}}</a>{{/each}}
                {{/if}}
              {{else}}
                <span class="dash">—</span>
              {{/if}}
            </td>
            <td class="col-due">
              {{#if this.assessment}}{{this.assessment}}{{else}}<span class="dash">—</span>{{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</section>
