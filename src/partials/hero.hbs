<section id="home" class="hero">
  <div class="wrap">
    <p class="hero-eyebrow">{{course.code}} · {{course.program}}</p>
    <h1 class="hero-title">{{course.title}}</h1>
    <dl class="hero-facts">
      <div><dt>Credits</dt><dd>{{course.credits}}</dd></div>
      <div><dt>In class</dt><dd>{{course.hours.in_class}} h</dd></div>
      <div><dt>Self-study</dt><dd>{{course.hours.self_study}} h</dd></div>
    </dl>
    <p class="cta-row">
      <a class="btn" href="{{url 'syllabus.html'}}">Full syllabus</a>
      {{#if course.links.book}}<a class="btn btn-quiet" href="{{course.links.book}}">Course book</a>{{/if}}
      {{#if course.links.slides}}<a class="btn btn-quiet" href="{{course.links.slides}}">Slides</a>{{/if}}
      {{#if course.links.practice}}<a class="btn btn-quiet" href="{{course.links.practice}}">Practice with Score Up</a>{{/if}}
    </p>
  </div>
</section>
