<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="{{url 'index.html'}}">
      <img class="brand-logo" src="{{url 'assets/images/neu-logo.png'}}" alt="National Economics University logo">
      <img class="brand-logo" src="{{url 'assets/images/fda-logo.png'}}" alt="Faculty of Data Science and Artificial Intelligence logo">
      <span class="brand-text">
        <span class="brand-course">DS for Business</span>
        <span class="brand-dept">National Economics University</span>
      </span>
    </a>

    {{!-- page.prefix is "" on the home page and "index.html" elsewhere, so the
          section fragments resolve from every page. The old navbar also carried
          an "#assignments" link whose section is commented out of index.hbs;
          it is gone, because the build now rejects dead anchors. --}}
    <nav class="site-nav" aria-label="Primary">
      <a href="{{page.prefix}}#overview">Overview</a>
      <a href="{{page.prefix}}#schedule">Schedule</a>
      <a href="{{page.prefix}}#quizzes">Quizzes</a>
      <a href="{{page.prefix}}#instructors">Instructors</a>
      <a href="{{url 'syllabus.html'}}" {{#if (eq page.nav 'syllabus')}}class="is-active" aria-current="page"{{/if}}>Syllabus</a>
      <a href="{{url 'grading.html'}}" {{#if (eq page.nav 'grading')}}class="is-active" aria-current="page"{{/if}}>Grading</a>
      <a href="{{url 'policies.html'}}" {{#if (eq page.nav 'policies')}}class="is-active" aria-current="page"{{/if}}>Policies</a>
      <a href="{{url 'resources.html'}}" {{#if (eq page.nav 'resources')}}class="is-active" aria-current="page"{{/if}}>Resources</a>
    </nav>
  </div>
  {{#if withSolutions}}
  <div class="keys-banner">Instructor build — contains solutions. Do not publish.</div>
  {{/if}}
</header>
